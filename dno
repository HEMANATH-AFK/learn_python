num = int(input("Enter a number: "))

# Step 1: Find the total number of digits mathematically
temp = num
length = 0
while temp > 0:
    length += 1
    temp //= 10

# Step 2: Extract digits from right to left and calculate the sum
temp = num
total = 0
current_position = length

while temp > 0:
    digit = temp % 10                  # Get the last digit
    total += digit ** current_position # Raise digit to its position power and add to total
    current_position -= 1              # Decrease position for the next digit to the left
    temp //= 10                        # Remove the last digit from the number

# Step 3: Compare the calculated total to the original number
if total == num:
    print(f"{num} is a Disarium number")
else:
    print(f"{num} is not a Disarium number")
